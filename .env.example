# Lakera Guard Demo — API Keys
# Copy this file to .env and fill in your values.
# Environment variables take precedence over values in this file.
# Note: inline comments (KEY=value # comment) are NOT supported — put comments on their own line.

# ── Lakera Guard ──────────────────────────────────────────
LAKERA_API_KEY=

# Project for Guard IN (prompt screening)
LAKERA_GUARD_IN_PROJECT_ID=
LAKERA_GUARD_IN_PROJECT_NAME=

# Project for Guard OUT (response screening)
LAKERA_GUARD_OUT_PROJECT_ID=
LAKERA_GUARD_OUT_PROJECT_NAME=

# Shared fallback — used for both IN and OUT if the specific vars above are not set
LAKERA_PROJECT_ID=
LAKERA_PROJECT_NAME=

# Optional: override the default endpoint (applies to both IN and OUT)
# LAKERA_ENDPOINT=https://api.lakera.ai/v2/guard

# ── LLM Provider ──────────────────────────────────────────
# Provider: openai | anthropic | gemini | ollama | lmstudio
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

# Only needed for ollama / lmstudio
# LLM_ENDPOINT=

# Optional: override the default system prompt
# LLM_SYSTEM_PROMPT=You are a helpful assistant.
